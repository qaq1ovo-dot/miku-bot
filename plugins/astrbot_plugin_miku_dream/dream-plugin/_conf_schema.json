{
  "enable": {
    "description": "启用睡眠与做梦",
    "type": "bool",
    "hint": "长时间没消息她会睡着，醒来时做梦",
    "default": true
  },
  "sleep_after_minutes": {
    "description": "多久没消息算睡着",
    "type": "int",
    "hint": "默认 180（3 小时）",
    "default": 180
  },
  "night_only": {
    "description": "只在夜间睡眠",
    "type": "bool",
    "hint": "开启后只有 23:00~09:00 才会睡",
    "default": false
  },
  "inject_dream": {
    "description": "把当天的梦带进对话",
    "type": "bool",
    "hint": "她会隐约记得梦见过什么",
    "default": true
  },
  "keep_days": {
    "description": "保留几天的梦",
    "type": "int",
    "hint": "默认 7",
    "default": 7
  }
}
