{
  "enable": {
    "description": "启用桌宠桥接",
    "type": "bool",
    "hint": "把回复推送到新桌宠",
    "default": true
  },
  "endpoint": {
    "description": "桌宠 API 地址",
    "type": "string",
    "hint": "服务器上通常指向 SSH 隧道端口，如 http://127.0.0.1:19890",
    "default": "http://127.0.0.1:19890"
  },
  "token": {
    "description": "桌宠 API token",
    "type": "string",
    "hint": "与桌宠 config.json 里 api.token 保持一致",
    "default": ""
  },
  "voice": {
    "description": "让桌宠出声",
    "type": "bool",
    "hint": "关掉只显示气泡",
    "default": true
  },
  "sync_thinking": {
    "description": "思考时切换状态",
    "type": "bool",
    "hint": "生成回复期间显示 thinking",
    "default": true
  },
  "sync_mood": {
    "description": "同步情绪到桌宠",
    "type": "bool",
    "hint": "心情好/累了会在动作上体现",
    "default": true
  },
  "max_chars": {
    "description": "气泡最多显示多少字",
    "type": "int",
    "hint": "超出部分截断，默认 120",
    "default": 120
  },
  "timeout": {
    "description": "请求超时（秒）",
    "type": "float",
    "hint": "默认 5",
    "default": 5.0
  },
  "chat_port": {
    "description": "桌宠聊天接口端口",
    "type": "int",
    "hint": "桌宠通过隧道访问这个端口来跟她对话，默认 19891",
    "default": 19891
  },
  "chat_token": {
    "description": "聊天接口鉴权 token",
    "type": "string",
    "hint": "留空则不校验（仅限本机隧道使用）",
    "default": ""
  },
  "persona_id": {
    "description": "人格 ID",
    "type": "string",
    "hint": "留空则用 personality_id=miku；要和 QQ 里一致就填 miku",
    "default": "miku"
  }
}
