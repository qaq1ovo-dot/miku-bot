# 环境变量模板
# 复制成 .env 并填入自己的值（.env 已在 .gitignore 中）

# ── 电脑控制 agent ─────────────────────────────
# 随机字符串，用于 pc_agent 与插件之间的鉴权
PC_AGENT_TOKEN=change-me-to-a-random-string
# agent 监听端口（默认 9883）
PC_AGENT_PORT=9883
# 插件侧访问 agent 的地址（SSH 隧道后通常是 127.0.0.1:19883）
PC_AGENT_URL=http://127.0.0.1:19883

# ── 视觉模型（看屏幕时描述画面用）─────────────
VISION_API_KEY=
# 可选：自定义接口地址与模型名
VISION_API_BASE=https://api.deepseek.com/chat/completions
VISION_MODEL=deepseek-flash

# ── 路径 ───────────────────────────────────────
# 写歌工程的存放目录
MIKU_MUSIC_DIR=music
# 音色素材目录
MIKU_VOICE_DIR=voices
# ffmpeg 可执行文件（不填则用 PATH 里的）
FFMPEG_PATH=ffmpeg
# 远程任务执行器监听的目录
MIKU_TASKS_DIR=tasks
